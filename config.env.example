# =====================================================================
# Gestión de Infraestructura de Red V0.4.0 - SERVIDOR CENTRAL
# INSTALAR.bat conserva este archivo al actualizar una instalación.
# =====================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=monitor_red

PORT=3000
ADMIN_USER=admin
# Sólo se usa para crear el administrador si todavía no existe. Use 10+ caracteres.
ADMIN_PASSWORD=

JWT_SECRET=
# Token bootstrap para conservar compatibilidad con instalaciones V0.3.x.
# Los nuevos agentes deben crearse desde Administración > Agentes y usar su AGENT_TOKEN individual.
AGENT_BOOTSTRAP_TOKEN=
# Compatibilidad histórica; puede quedar vacío en instalaciones nuevas.
PROBE_TOKEN=

# Agente local opcional en el mismo equipo del servidor.
START_LOCAL_AGENT=true
AGENT_TOKEN=
AGENT_NAME=Agente-Principal
API_URL=http://localhost:3000/api
CONFIG_REFRESH_SEC=60
HEARTBEAT_SEC=30
PROBE_CONCURRENCY=5
# Los colectores SNMP corren en su propio ciclo para no retrasar los sondeos ping/tcp.
SNMP_CONCURRENCY=2
DEVICE_TIMEOUT_MS=60000
# Paquetes por sondeo ICMP: con más de uno se puede medir la pérdida real.
PING_COUNT=4
AGENT_BUFFER_MAX_ATTEMPTS=20
API_TIMEOUT_MS=8000
SNMP_PROFILES_FILE=./config/snmp-profiles.json
DNS_TEST_NAME=www.microsoft.com
AGENT_BUFFER_DB=./data/agent-buffer.sqlite
AGENT_BUFFER_MAX=10000

CORS_ORIGIN=http://localhost:3000,http://localhost:4200
RETENTION_DAYS=30
HEARTBEAT_RETENTION_HOURS=48
RETENTION_EVERY_MIN=60
AUDIT_RETENTION_DAYS=365
AGENT_STALE_SEC=90
# Compatibilidad histórica.
PROBE_STALE_SEC=90
# Evita falsos positivos: 3 fallos para abrir; 2 éxitos para cerrar.
FAIL_CONFIRMATIONS=3
RECOVERY_CONFIRMATIONS=2
