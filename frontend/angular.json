{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "monitor-red": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {"builder":"@angular/build:application","options":{"browser":"src/main.ts","tsConfig":"tsconfig.app.json","index":"src/index.html","styles":["src/styles.css"],"outputPath":"dist/monitor-red"}},
        "serve": {"builder":"@angular/build:dev-server","options":{"buildTarget":"monitor-red:build","proxyConfig":"proxy.conf.json"}}
      }
    }
  }
}
