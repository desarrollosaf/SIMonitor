# Copie este archivo a ".env" (en la misma carpeta que docker-compose.yml)
# y complete los valores. "docker compose" lo carga automáticamente.
# NUNCA suba el ".env" real a git (ya está en .gitignore).

# --- Su MySQL propio (fuera de este docker-compose) ---
# Host/IP donde escucha su MySQL.
# - Si MySQL está en OTRO servidor: DB_HOST=<esa IP o dominio>
# - Si MySQL está en ESTE MISMO servidor pero instalado fuera de Docker (no en
#   contenedor): NO use "localhost" ni "127.0.0.1" (eso apuntaría al propio
#   contenedor). Use DB_HOST=host.docker.internal (ya está habilitado en
#   docker-compose.yml) y asegúrese de que MySQL escuche en 0.0.0.0, no sólo
#   en 127.0.0.1 (bind-address en my.cnf), y que su usuario tenga permiso para
#   conectarse desde la IP del contenedor, no sólo desde 'localhost'.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=monitor_user
DB_PASSWORD=CambieEstaClave123!
DB_NAME=monitor_red
# El usuario de MySQL necesita permisos SELECT, INSERT, UPDATE, DELETE, CREATE,
# ALTER, INDEX, REFERENCES sobre DB_NAME (el sistema crea las tablas solo).
# Si DB_NAME no existe todavía, créela primero: CREATE DATABASE monitor_red
# CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;

# --- Servidor central ---
WEB_PORT=3000
# Prefijo de publicación. Deje "/" para servir en la raíz del dominio.
# Ej: si se publica en https://siasaf.gob.mx/redes use BASE_HREF=/redes/
# (con la barra inicial y final). Requiere reconstruir la imagen si cambia:
# docker compose build app
BASE_HREF=/
ADMIN_USER=admin
# Mínimo 10 caracteres. Sólo se usa para crear el administrador la primera vez.
ADMIN_PASSWORD=CambieEstaClaveAdmin123!
# Genere uno aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambie_esto_por_una_cadena_aleatoria_de_al_menos_32_caracteres
# Dominios/IPs desde los que se accederá a la web (separados por coma)
CORS_ORIGIN=http://localhost:3000

# --- Retención de datos (opcional, tienen valores por defecto) ---
RETENTION_DAYS=30
HEARTBEAT_RETENTION_HOURS=48
AUDIT_RETENTION_DAYS=365

# --- Agente local opcional (perfil "local-agent") ---
# Cree el agente desde la web (Agentes / Admin) y pegue aquí el token que muestra una sola vez.
AGENT_TOKEN=
AGENT_NAME=Agente-Docker-Local
AGENT_API_URL=http://localhost:3000/api
